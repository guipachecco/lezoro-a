# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). A chave "anon" é pública; nunca coloque a "service_role" aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Chave pública de notificações (a privada fica só nos Secrets do Supabase)
VITE_VAPID_PUBLIC_KEY=
